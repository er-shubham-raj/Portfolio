# EmailJS Credentials Setup Guide:
# 1. Sign up at https://www.emailjs.com/
# 2. Create an Email Service (e.g. Gmail) -> Copy Service ID to VITE_EMAILJS_SERVICE_ID
# 3. Create an Email Template -> Copy Template ID to VITE_EMAILJS_TEMPLATE_ID
# 4. Go to Account > Public Key -> Copy Public Key to VITE_EMAILJS_PUBLIC_KEY

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
